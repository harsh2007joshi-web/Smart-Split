# ==========================================
# SplitSmart AI — Configuration Environment
# PayPal AI Hackathon | Master Environment Template
# ==========================================

# Server Port & Core Security
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_change_in_production
NODE_ENV=development

# ========================================================
# Public Application URL (Normal link for sharing with friends)
# ========================================================
# Set this to your public tunnel link (e.g. from Cloudflare, ngrok, or localtunnel)
# Example: APP_URL=https://splitsmart.trycloudflare.com or https://xxxx.ngrok-free.app
# If left empty, the server automatically uses the URL you visit in your browser.
APP_URL=

# Database Configuration (Optional PostgreSQL connection URL)
# Note: By default, SplitSmart AI uses a high-performance, persistent JSON/ACID store.
# To connect to PostgreSQL via Prisma, set:
DATABASE_URL="postgresql://username:password@localhost:5432/splitsmart_db?schema=public"

# PayPal Developer Sandbox Credentials
# Register your sandbox app at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_SANDBOX=true

# AI Provider API Key (Google Gemini)
# Get a free Gemini API Key from https://aistudio.google.com/
# If left blank, SplitSmart AI operates in high-precision Local Financial NLP Engine mode.
GEMINI_API_KEY=your_google_gemini_api_key_here

# 2Factor.in SMS Gateway Configuration
# Register and get your API Key at https://2factor.in/
TWOFACTOR_API_KEY=your_2factor_in_api_key_here

# ========================================================
# Real Email Delivery API Configuration (Email Connect)
# ========================================================
# OPTION 1: Resend API (Fastest & easiest, 3,000 free emails/month)
# 1. Sign up at https://resend.com
# 2. Generate an API Key under "API Keys"
# 3. Paste key below:
RESEND_API_KEY=
RESEND_FROM="SplitSmart AI <onboarding@resend.dev>"

# OPTION 2: Gmail SMTP (Use your personal or developer Gmail)
# 1. Visit https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled)
# 2. Create an App Password for "SplitSmart" (generates a 16-character password)
# 3. Fill in:
# SMTP_SERVICE=gmail
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_char_google_app_password
# SMTP_FROM="SplitSmart AI <your_email@gmail.com>"

# OPTION 3: Custom SMTP / Resend SMTP / SendGrid / Brevo
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_smtp_or_resend_api_key_here
SMTP_FROM="SplitSmart AI <no-reply@splitsmart.ai>"
